# Copy this file to .env and fill in the values before running the app.
# Never commit .env or real API keys.

# Required for Supabase authentication and farmer profile storage.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional. Open-Meteo is used automatically when this is empty.
VITE_OPENWEATHER_API_KEY=

# Optional in-app translation provider.
VITE_GOOGLE_TRANSLATE_API_KEY=

# Optional. Keep the proxy path for local development.
VITE_MANDI_API_BASE=/mandi-api

# Optional direct backend origin for preview/production.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8001
